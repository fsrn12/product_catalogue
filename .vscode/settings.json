{
  "window.zoomLevel": 0,
  "files.eol": "\n",
  "notebook.insertFinalNewline": true,
  "editor.trimAutoWhitespace": true,
  "editor.acceptSuggestionOnEnter": "on",
  "editor.fontFamily": "'Dank Mono','Cascadia Mono NF light','Operator Mono', Consolas, 'Courier New', monospace",
  "editor.fontSize": 14,
  "editor.letterSpacing": 2,
  "editor.lineHeight": 40,
  "editor.fontWeight": "100",
  "editor.wordBasedSuggestions": "allDocuments",
  "editor.suggestOnTriggerCharacters": true,
  "editor.inlineSuggest.enabled": true,
  "editor.suggest.showSnippets": true,
  "editor.suggest.localityBonus": true,
  "editor.suggest.selectionMode": "always",
  "editor.codeActionWidget.showHeaders": true,
  "editor.codeActionWidget.includeNearbyQuickFixes": true,
  "editor.snippetSuggestions": "inline",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "material-icon-theme.folders.theme": "specific",
  "material-icon-theme.activeIconPack": "react",
  "material-icon-theme.folders.color": "#B2C4CF",
  "material-icon-theme.hidesExplorerArrows": true,
  "material-icon-theme.opacity": 1,
  "material-icon-theme.saturation": 1,
  "workbench.colorCustomizations": {
    "editor.background": "#141414",
    "sideBar.foreground": "#1feb36",
    "sideBar.background": "#101111",
    "terminal.background": "#090909"
  }
}
